# =====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG BACKEND QUIZ ONLINE (Vercel & Supabase)
# =====================================================================

# 1. Supabase Credentials (Lấy từ Supabase Project Settings -> API)
# SUPABASE_URL: URL định danh của project Supabase
SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE_SERVICE_ROLE_KEY: Khóa bảo mật cao nhất dùng cho Serverless Functions (Bypass RLS)
# TUYỆT ĐỐI KHÔNG để lộ khóa này ra Frontend!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# SUPABASE_ANON_KEY: Khóa công khai nếu cần (tùy chọn)
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Cấu hình bảo mật ứng dụng
# APP_ORIGIN: Domain frontend được phép truy cập CORS (VD: https://myquiz.vercel.app hoặc http://localhost:3000)
# Dùng "*" chỉ trong môi trường phát triển local
APP_ORIGIN=*

# ADMIN_SECRET: Khóa bí mật dùng cho các API quản trị (/api/v1/admin/*)
ADMIN_SECRET=your-super-strong-admin-secret-key-32chars

# 3. Giới hạn phòng và tốc độ
MAX_PLAYERS_PER_ROOM=50
DEFAULT_QUESTION_TIME_SECONDS=20
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
